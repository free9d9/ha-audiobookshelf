        "default": "mdi:book-multiple"
      },
      "duration": {
        "default": "mdi:clock-outline"
      },
      "size": {
        "default": "mdi:harddisk"
      },
      "listening_now": {
        "default": "mdi:headphones",
        "state": {
          "0": "mdi:headphones-off"
        }
      },
      "users_online": {
        "default": "mdi:account-network"
      },
      "users": {
        "default": "mdi:account-group"
      },
      "libraries": {
        "default": "mdi:bookshelf"
      },
      "open_sessions": {
        "default": "mdi:play-box-multiple"
      },
      "listening_today": {
        "default": "mdi:headphones"
      },
      "listening_week": {
        "default": "mdi:calendar-week"
      },
      "listening_month": {
        "default": "mdi:calendar-month"
      },
      "listening_year": {
        "default": "mdi:calendar-star"
      },
      "listening_all_time": {
        "default": "mdi:history"
      },
      "issues": {
        "default": "mdi:book-alert"
      },
      "last_scan": {
        "default": "mdi:clock-check-outline"
      }
    },
    "binary_sensor": {
      "realtime": {
        "default": "mdi:lightning-bolt",
        "state": {
